{
  "name": "desabafo-anonimo",
  "description": "Aplicação web full-stack que oferece um espaço seguro e anônimo para as pessoas expressarem seus sentimentos. Além de poder fazer desabafos, os usuários também poderão apoiar o desabafo de outras pessoas, criando assim um ambiente de acolhimento e conforto.",
  "author": "Ygor Evaldt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-postgres && npm run migration:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "migration:up": "prisma migrate deploy",
    "build": "npm run migration:up && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "node infra/scripts/run-tests.js",
    "test:prepare": "npm run services:up && npm run wait-for-postgres && npm run migration:up",
    "test:run": "vitest run",
    "test:watch": "npm run test:prepare && vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@prisma/client": "5.22.0",
    "axios": "1.7.7",
    "date-fns": "4.1.0",
    "dotenv": "16.4.5",
    "nanoid": "5.0.9",
    "next": "15.0.7",
    "react": "19.0.0-rc-02c0e824-20241028",
    "react-dom": "19.0.0-rc-02c0e824-20241028",
    "react-icons": "5.3.0",
    "sweetalert2": "11.14.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/supertest": "7.2.1",
    "@vitest/ui": "2.1.4",
    "postcss": "8",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "supertest": "7.3.0",
    "tailwindcss": "3.4.1",
    "typescript": "5",
    "vitest": "2.1.4"
  }
}
