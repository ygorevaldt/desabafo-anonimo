# Dev Environment
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database
POSTGRESQL_USERNAME=local_user
POSTGRESQL_PASSWORD=local_password
POSTGRESQL_DATABASE=local_desabafo_anonimo
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432

# Prisma
DATABASE_URL="postgresql://${POSTGRESQL_USERNAME}:${POSTGRESQL_PASSWORD}@${POSTGRESQL_HOST}:${POSTGRESQL_PORT}/${POSTGRESQL_DATABASE}?schema=public"

# AI Moderation & Empathy (Gemini)
# Opcional para desenvolvimento local: se omitida, o sistema usa o fallback heurístico inteligente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
